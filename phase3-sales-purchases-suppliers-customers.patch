+    "/{purchase_order_id}/cancel",
+    response_model=PurchaseOrderResponse,
+)
+def cancel_purchase_order(
+    purchase_order_id: int,
+    db: Session = Depends(get_db),
+):
+    return service.cancel(db, purchase_order_id)
