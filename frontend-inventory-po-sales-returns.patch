+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Sales / POS -- FreshScape Market POS</title>
+<link rel="stylesheet" href="../css/style.css">
+<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
+<style>
+  .pos-layout {
+    display: grid;
+    grid-template-columns: 1fr 360px;
+    gap: var(--space-5);
+    align-items: start;
+  }
+  .product-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
+    gap: var(--space-3);
+  }
+  .product-tile {
+    background: var(--surface);
+    border: 1px solid var(--line-soft);
+    border-radius: var(--radius-md);
+    padding: var(--space-3);
+    cursor: pointer;
+    text-align: left;
+    transition: border-color 0.12s ease, transform 0.08s ease;
+    font-family: var(--font-body);
+  }
+  .product-tile:hover { border-color: var(--market-green); }
+  .product-tile:active { transform: translateY(1px); }
+  .product-tile:disabled { opacity: 0.45; cursor: not-allowed; }
+  .product-tile__name { font-weight: 600; font-size: 14px; margin-bottom: 2px; }
+  .product-tile__meta { font-size: 12px; color: var(--ink-soft); margin-bottom: var(--space-2); }
+  .product-tile__price { font-family: var(--font-mono); font-weight: 600; }
+
+  .cart-panel {
+    position: sticky;
+    top: var(--space-5);
+    background: var(--surface);
+    border: 1px solid var(--line-soft);
+    border-radius: var(--radius-lg);
+    padding: var(--space-4);
+    box-shadow: var(--shadow-card);
+  }
+  .cart-item {
+    display: flex;
+    align-items: center;
+    gap: var(--space-2);
+    padding: var(--space-2) 0;
+    border-bottom: 1px solid var(--line-soft);
+  }
+  .cart-item:last-child { border-bottom: none; }
+  .cart-item__name { flex: 1; font-size: 13px; }
+  .cart-item__qty-btn {
+    background: var(--paper-raised);
+    border: 1px solid var(--line);
+    border-radius: 4px;
+    width: 22px; height: 22px;
+    cursor: pointer;
+    font-size: 13px;
+    line-height: 1;
+  }
+  .cart-empty {
+    text-align: center;
+    color: var(--ink-soft);
+    font-size: 13px;
+    padding: var(--space-5) 0;
+  }
+</style>
+</head>
+<body data-page="sales">
+
+  <div class="app-shell">
+    <div id="sidebar-root"></div>
+
+    <main class="main" x-data="posPage()" x-init="init()" style="max-width: none;">
+      <div class="page-header">
+        <div>
+          <div class="page-header__eyebrow">Point of Sale</div>
+          <h1>New Sale</h1>
+        </div>
+      </div>
+
+      <div class="pos-layout">
+        <!-- Product picker -->
+        <div>
+          <input type="text" placeholder="Search products by name, SKU, or barcode..."
+                 x-model="searchQuery"
+                 style="width: 100%; padding: 10px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); font-family: var(--font-body); margin-bottom: var(--space-4);">
+
+          <div class="product-grid">
+            <template x-for="p in filteredProducts" :key="p.id">
+              <button type="button" class="product-tile" :disabled="p.stock_quantity <= 0" @click="addToCart(p)">
+                <div class="product-tile__name" x-text="p.name"></div>
+                <div class="product-tile__meta">
+                  <span x-text="p.stock_quantity + ' in stock'"></span>
+                </div>
+                <div class="product-tile__price" x-text="'Rs ' + parseFloat(p.selling_price).toFixed(2)"></div>
+              </button>
+            </template>
+          </div>
+
+          <p class="text-soft text-sm" x-show="filteredProducts.length === 0" style="margin-top: var(--space-4);">
+            No products match "<span x-text="searchQuery"></span>".
+          </p>
+        </div>
+
+        <!-- Cart -->
+        <div class="cart-panel">
+          <h3>Cart</h3>
+
+          <div x-show="cart.length === 0" class="cart-empty">Tap a product to add it.</div>
+
+          <div x-show="cart.length > 0">
+            <template x-for="item in cart" :key="item.product.id">
+              <div class="cart-item">
+                <div class="cart-item__name">
+                  <div x-text="item.product.name"></div>
+                  <div class="text-soft mono" style="font-size: 11px;" x-text="'Rs ' + parseFloat(item.product.selling_price).toFixed(2) + ' ea'"></div>
+                </div>
+                <button type="button" class="cart-item__qty-btn" @click="decrementQty(item)">&minus;</button>
+                <span class="mono text-sm" style="min-width: 20px; text-align: center;" x-text="item.quantity"></span>
+                <button type="button" class="cart-item__qty-btn" @click="incrementQty(item)" :disabled="item.quantity >= item.product.stock_quantity">+</button>
+                <button type="button" class="cart-item__qty-btn" @click="removeFromCart(item)" title="Remove" style="color: var(--stamp-red);">&times;</button>
+              </div>
+            </template>
+
+            <div class="field" style="margin-top: var(--space-4);">
+              <label>Customer (optional)</label>
+              <select x-model="customerId">
+                <option value="">Walk-in</option>
+                <template x-for="c in customers" :key="c.id">
+                  <option :value="c.id" x-text="c.name"></option>
+                </template>
+              </select>
+            </div>
+
+            <div class="field">
+              <label>Payment method</label>
+              <select x-model="paymentMethod">
+                <option value="cash">Cash</option>
+                <option value="card">Card</option>
+                <option value="mobile">Mobile</option>
+              </select>
+            </div>
+
+            <div class="flex-between" style="margin: var(--space-4) 0; padding-top: var(--space-3); border-top: 1px solid var(--line);">
+              <span style="font-weight: 600;">Total</span>
+              <span class="mono" style="font-weight: 600; font-size: 18px;" x-text="'Rs ' + cartTotal.toFixed(2)"></span>
+            </div>
+
+            <button class="btn btn-primary" style="width: 100%; justify-content: center;"
+                    :disabled="submitting" @click="checkout()"
+                    x-text="submitting ? 'Processing...' : 'Complete Sale'"></button>
+          </div>
+        </div>
+      </div>
+
+      <!-- Receipt confirmation -->
+      <div class="modal-backdrop" x-show="showReceiptModal" x-cloak @click.self="closeReceipt()">
+        <div class="receipt-card" style="max-width: 380px; width: 100%;" x-show="lastReceipt">
+          <template x-if="lastReceipt">
+            <div>
+              <div style="text-align: center; margin-bottom: var(--space-4);">
+                <div style="font-family: var(--font-display); font-size: 22px; font-weight: 600;">FreshScape Market</div>
+                <div class="text-soft text-sm mono">Sale #<span x-text="lastReceipt.id"></span></div>
+                <div class="text-soft text-sm mono" x-text="formatDate(lastReceipt.created_at)"></div>
+              </div>
+
+              <table>
+                <tbody>
+                  <template x-for="item in lastReceipt.items" :key="item.id">
+                    <tr>
+                      <td style="padding-left: 0;">
+                        <span x-text="item.quantity + '\u00d7 ' + item.product.name"></span>
+                      </td>
+                      <td class="mono" style="text-align: right; padding-right: 0;"
+                          x-text="'Rs ' + (item.quantity * item.unit_price).toFixed(2)"></td>
+                    </tr>
+                  </template>
+                </tbody>
+              </table>
+
+              <div class="flex-between" style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px dashed var(--line);">
+                <span style="font-weight: 600;">Total</span>
+                <span class="mono" style="font-weight: 600;" x-text="'Rs ' + parseFloat(lastReceipt.total_amount).toFixed(2)"></span>
+              </div>
+              <div class="text-soft text-sm" style="margin-top: var(--space-2);">
+                Paid via <span x-text="lastReceipt.payment_method"></span>
+                <span x-show="lastReceipt.customer"> &middot; <span x-text="lastReceipt.customer?.name"></span></span>
+              </div>
+
+              <button class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: var(--space-5);" @click="closeReceipt()">New sale</button>
+            </div>
+          </template>
+        </div>
+      </div>
+    </main>
+  </div>
+
+  <script src="../js/api.js"></script>
+  <script src="../js/layout.js"></script>
+  <script>
+    function posPage() {
+      return {
+        products: [],
+        customers: [],
+        searchQuery: '',
+        cart: [],
+        customerId: '',
+        paymentMethod: 'cash',
+        submitting: false,
+        showReceiptModal: false,
+        lastReceipt: null,
+
+        async init() {
+          await this.reloadProducts();
+          try {
+            this.customers = await api.get('/customers');
+          } catch (err) {
+            toast(err.message);
+          }
+        },
+
+        async reloadProducts() {
+          try {
+            const productsPage = await api.get('/products?page=1&page_size=100&is_active=true');
+            this.products = productsPage.items;
+          } catch (err) {
+            toast(err.message);
+          }
+        },
+
+        get filteredProducts() {
+          const q = this.searchQuery.trim().toLowerCase();
+          if (!q) return this.products;
+          return this.products.filter(p =>
+            p.name.toLowerCase().includes(q) ||
+            p.sku.toLowerCase().includes(q) ||
+            p.barcode.toLowerCase().includes(q)
+          );
+        },
+
+        get cartTotal() {
+          return this.cart.reduce((sum, item) => sum + item.quantity * parseFloat(item.product.selling_price), 0);
+        },
+
+        addToCart(product) {
+          if (product.stock_quantity <= 0) return;
+          const existing = this.cart.find(i => i.product.id === product.id);
+          if (existing) {
+            if (existing.quantity < product.stock_quantity) {
+              existing.quantity++;
+            } else {
+              toast(`Only ${product.stock_quantity} of "${product.name}" in stock.`);
+            }
+          } else {
+            this.cart.push({ product, quantity: 1 });
+          }
+        },
+
+        incrementQty(item) {
+          if (item.quantity < item.product.stock_quantity) {
+            item.quantity++;
+          } else {
+            toast(`Only ${item.product.stock_quantity} of "${item.product.name}" in stock.`);
+          }
+        },
+
+        decrementQty(item) {
+          item.quantity--;
+          if (item.quantity <= 0) this.removeFromCart(item);
+        },
+
+        removeFromCart(item) {
+          this.cart = this.cart.filter(i => i.product.id !== item.product.id);
+        },
+
+        async checkout() {
+          if (this.cart.length === 0) return;
+          this.submitting = true;
+          try {
+            const payload = {
+              customer_id: this.customerId ? parseInt(this.customerId, 10) : null,
+              payment_method: this.paymentMethod,
+              items: this.cart.map(item => ({
+                product_id: item.product.id,
+                quantity: item.quantity,
+                // unit_price intentionally omitted -- backend defaults
+                // to the product's current selling_price.
+              })),
+            };
+            const sale = await api.post('/sales', payload);
+            this.lastReceipt = sale;
+            this.showReceiptModal = true;
+            this.cart = [];
+            this.customerId = '';
+            this.paymentMethod = 'cash';
+            await this.reloadProducts();
+          } catch (err) {
+            toast(err.message);
+          } finally {
+            this.submitting = false;
+          }
+        },
+
+        closeReceipt() {
+          this.showReceiptModal = false;
+          this.lastReceipt = null;
+        },
+
+        formatDate(iso) {
+          const d = new Date(iso);
+          return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+        },
+      };
+    }
+  </script>
+</body>
+</html>
